# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# Никогда не коммитьте файл .env в git — он уже добавлен в .gitignore.

# Токен Telegram-бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API-ключ DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Базовый URL DeepSeek API (обычно менять не нужно)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Модель DeepSeek: deepseek-chat (быстрая) или deepseek-reasoner (с рассуждениями)
DEEPSEEK_MODEL=deepseek-chat

# Необязательные настройки (можно не указывать — будут использованы значения по умолчанию)
REQUEST_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=2000
MAX_INPUT_CHARS=4000
