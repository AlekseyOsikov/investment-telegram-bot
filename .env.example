# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
#
# Никогда не коммитьте файл .env в git — он уже добавлен в .gitignore.

# Токен Telegram-бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- Основной поток бота: какой провайдер и какая модель ---
# MAIN_CLIENT выбирает провайдера для основного потока (main.py) и для research-режимов,
# которые сами не выбирают конкретную модель (/research_reasoning, /research_temperature,
# /research_response_format) — допустимые значения: "deepseek" или "kimi".
# От выбора зависит, какой из двух API-ключей ниже обязателен для запуска бота:
#   MAIN_CLIENT=deepseek (по умолчанию) — обязателен DEEPSEEK_API_KEY, KIMI_API_KEY опционален.
#   MAIN_CLIENT=kimi                    — обязателен KIMI_API_KEY, DEEPSEEK_API_KEY опционален.
# Необязательный ключ нужен только сценариям /research_models на моделях этого провайдера
# и не блокирует запуск бота, если не задан.
MAIN_CLIENT=deepseek

# Модель основного потока — единственная переменная на оба провайдера (используется тем
# из них, что выбран в MAIN_CLIENT). Например: deepseek-v4-flash/deepseek-v4-pro для
# DeepSeek или kimi-k3/kimi-k2.6 для Kimi.
MAIN_MODEL=deepseek-v4-flash

# --- DeepSeek API (https://platform.deepseek.com/api_keys) ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Kimi / Moonshot AI API (https://platform.moonshot.ai) ---
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1

# --- Модели, сравниваемые в /research_models (research_models.py) ---
# Идентификаторы конкретных моделей у провайдеров могут меняться быстрее кода бота,
# поэтому они вынесены сюда, а не захардкожены в исследовании. Не зависят от MAIN_CLIENT —
# этот режим всегда сравнивает обе пары моделей обоих провайдеров.
DEEPSEEK_MODEL_PRO=deepseek-v4-pro
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
KIMI_MODEL_K3=kimi-k3
KIMI_MODEL_K2_6=kimi-k2.6

# --- Доступ к исследовательским/техническим командам ---
# RESEARCH включает/выключает исследовательские и служебные команды: /research_constraints,
# /research_reasoning, /research_temperature, /research_models, /research_chunking_stats,
# /research_chunking_compare, /agent_compare, /agent_compare_report, /agent_compare_reset,
# /agent_mode, /agent_context, /mcp_tools. Это технические
# эксперименты и инструменты отладки, а не часть основного сценария использования бота —
# при RESEARCH=false они не регистрируются как обработчики и не показываются в /help.
# Не затрагивает /agent, /agent_reset, /agent_history и /agent_checkpoint/agent_branch/
# agent_switch_branch — они остаются доступны всегда.
# Допустимые значения: true/false (также принимаются 1/0, yes/no, on/off). По умолчанию — true.
RESEARCH=true

# Необязательные настройки (можно не указывать — будут использованы значения по умолчанию)
REQUEST_TIMEOUT_SECONDS=60
MAX_OUTPUT_TOKENS=2000
MAX_INPUT_CHARS=4000

# Каталог для JSON-файлов истории диалога агента (agents/agent.py), один файл на chat_id.
AGENT_HISTORY_DIR=data/agent_history

# --- Управление контекстом агента (agents/agent.py) ---
# Более старая часть истории периодически сворачивается в сводку (summary) и в LLM
# передаётся сводка + свежий "хвост" истории вместо всей истории целиком.
# AGENT_CONTEXT_RECENT_PAIRS — минимальное число последних пар вопрос-ответ, которые
# никогда не сворачиваются в сводку и всегда передаются как есть.
AGENT_CONTEXT_RECENT_PAIRS=10
# AGENT_SUMMARY_CHUNK_PAIRS — раз в сколько пар (сверх AGENT_CONTEXT_RECENT_PAIRS)
# пересчитывается сводка (сворачивается очередной блок из стольких пар).
AGENT_SUMMARY_CHUNK_PAIRS=10
# AGENT_SUMMARY_MAX_TOKENS — лимит длины самой сводки (max_tokens запроса на сворачивание).
AGENT_SUMMARY_MAX_TOKENS=500

# AGENT_CONTEXT_STRATEGY — стратегия управления контекстом /agent по умолчанию для новых
# чатов и для миграции файлов истории в старом формате. Допустимые значения: "summary"
# (сводка + хвост, поведение как раньше), "sliding_window" (последние
# AGENT_CONTEXT_RECENT_PAIRS пар, без сводки), "sticky_facts" (словарь фактов + последние
# AGENT_CONTEXT_RECENT_PAIRS пар), "branching" (чекпоинты и ветки диалога). Пользователь
# переключает стратегию для своего чата в любой момент командой /agent_context — эта
# переменная влияет только на чаты, которые ещё не сделали свой выбор.
AGENT_CONTEXT_STRATEGY=summary

# AGENT_ENABLED_STRATEGIES — какие из 4 стратегий вообще предлагаются кнопками
# /agent_context (через запятую, без пробелов); остальные скрыты из выбора — например,
# чтобы временно спрятать ещё не обкатанную стратегию. AGENT_CONTEXT_STRATEGY обязана
# входить в этот список. По умолчанию — все 4.
AGENT_ENABLED_STRATEGIES=summary,sliding_window,sticky_facts,branching

# AGENT_FACTS_MAX_TOKENS — лимит длины ответа модели при обновлении словаря фактов
# в стратегии sticky_facts (вызывается после каждого вопроса пользователя). При сбое
# парсинга (обрезанный JSON) агент один раз повторяет запрос с удвоенным лимитом.
AGENT_FACTS_MAX_TOKENS=1500

# --- Память smart-агента (/smart_agent, agents/smart_agent.py) ---
# Независимый от /agent LLM-агент с явно разделённой моделью памяти: краткосрочная
# (диалог), рабочая (данные текущей задачи) и долговременная (факты) — каждая хранится
# отдельно и пишется только по явной команде пользователя. Поверх них — именованные
# профили персонализации (/smart_agent_profile): каждый профиль хранит СВОИ
# независимые три слоя памяти плюс явно заданные предпочтения (стиль, уровень опыта,
# формат ответа, отношение к риску, горизонт, интересы, что не затрагивать) —
# подробнее см. «Управление памятью smart-агента» в CLAUDE.md.
# Каталог для JSON-файлов памяти smart-агента, один файл на chat_id (отдельно от
# AGENT_HISTORY_DIR — файлов истории /agent того же чата).
AGENT_MEMORY_DIR=data/smart_agent_memory
# Сколько последних пар вопрос-ответ краткосрочного слоя уходит в контекст LLM.
AGENT_MEMORY_SHORT_TERM_PAIRS=10
# Максимум фактов в долговременной памяти — при превышении вытесняется самый старый,
# но сначала извлечённые автоматически, а не сохранённые тобой явно.
AGENT_MEMORY_LONG_TERM_MAX_FACTS=20
# Лимит токенов служебного вызова, который ведёт конечный автомат рабочей задачи
# (этап/шаг/ожидаемое действие) после каждого ответа smart-агента.
AGENT_TASK_STATE_MAX_TOKENS=800
# Лимит токенов укороченного служебного вызова, который определяет только начало
# новой задачи, когда активной задачи нет.
AGENT_TASK_START_MAX_TOKENS=200
# Инварианты smart-агента — жёсткие ограничения пользователя («без криптовалют», «доля
# акций не выше 40%»), которые агент не имеет права нарушать. Хранятся в профиле,
# отдельно от диалога, пишутся только явными командами (/smart_agent_invariant_add и
# /smart_agent_invariant_remove) — автоматической записи в этот слой нет.
# Максимум инвариантов на профиль. При превышении НИЧЕГО не вытесняется (в отличие от
# долговременной памяти) — добавление отклоняется, чтобы заданный тобой запрет не
# перестал действовать незаметно.
AGENT_MEMORY_MAX_INVARIANTS=10
# Максимальная длина одной формулировки: инвариант должен быть проверяемым правилом в
# одну фразу, иначе его нечем проверить ни модели, ни автоматической проверке.
AGENT_INVARIANT_MAX_CHARS=300
# Лимит токенов служебного вызова-ревизора, который проверяет готовый результат рабочей
# задачи на соответствие инвариантам (вызывается только в момент появления результата).
AGENT_INVARIANTS_MAX_TOKENS=400

# --- Подключение к MCP-серверу (команда /mcp_tools, mcp_integration/) ---
# Требует Node.js с npx на хосте бота (команда по умолчанию запускает сервер через npx).
# MCP_SERVER_COMMAND/MCP_SERVER_ARGS — команда запуска MCP-сервера по протоколу stdio и
# её аргументы (через пробел, разбираются как аргументы командной строки). Это настройка
# оператора бота — пользователь чата не может задать или изменить сервер.
# По умолчанию — публичный тестовый сервер @modelcontextprotocol/server-everything.
# Подсказка: чтобы первый вызов /mcp_tools не упёрся в тайм-аут, можно заранее "прогреть"
# кэш npx: npx -y @modelcontextprotocol/server-everything --help
MCP_SERVER_COMMAND=npx
MCP_SERVER_ARGS=-y @modelcontextprotocol/server-everything
# Общий тайм-аут (в секундах) на весь цикл подключения: запуск процесса, рукопожатие
# протокола и получение списка инструментов. Увеличь, если первый запуск npx скачивает
# пакет и не укладывается в значение по умолчанию.
MCP_TIMEOUT_SECONDS=60

# --- Рыночные данные для /smart_agent (MCP-серверы mcp-moex, mcp-bybit) ---
# Каталог проекта локального MCP-сервера данных Московской биржи (mcp-moex). Если задан,
# smart-агент может сам вызывать его инструменты (поиск бумаги, текущая цена, история
# цен), а ответы о ценах опираются на данные биржи, а не на память модели. Пусто —
# возможность выключена, бот работает как раньше. Нужен `uv` в PATH процесса бота:
# сервер запускается как `uv run --directory <каталог> mcp-moex` (без shell). Укажи
# АБСОЛЮТНЫЙ путь. Это настройка оператора: пользователь чата сервер выбрать не может.
# В самом чате доступ можно включать/выключать командой /smart_agent_toggle tools.
# Тайм-аут запуска и каждого вызова — MCP_TIMEOUT_SECONDS выше.
MCP_MOEX_DIR=
# Второй, независимый источник рыночных данных — MCP-сервер mcp-bybit (спотовые пары
# криптовалют Bybit, публичный v5 API без ключей). Тот же принцип, что MCP_MOEX_DIR:
# пусто — источник выключен и молчит; незаданность одного источника не влияет на
# другой — можно задать только MOEX, только Bybit, оба или ни одного. Сервер
# запускается как `uv run --directory <каталог> mcp-bybit`. Оба источника доступны
# модели ОДНОВРЕМЕННО, если настроены оба (имена инструментов получают признак
# источника — moex__.../bybit__...), а не выбираются по одному.
MCP_BYBIT_DIR=
# Третий источник — Банк России (пакет PyPI atomno-mcp-cbr-rates: официальные курсы
# валют, ключевая ставка, инфляция, макро-снимок). В отличие от MOEX/Bybit у него
# нет локального каталога проекта — сервер устанавливается и запускается
# автоматически через `uvx` при первом вопросе (сеть нужна хотя бы раз, дальше uvx
# кэширует пакет), поэтому настройка — простой булев флаг, а не путь. Пусто/false —
# источник выключен и молчит, независимо от MOEX/Bybit. Допустимые значения:
# true/false (также принимаются 1/0, yes/no, on/off). По умолчанию — false.
MCP_CBR_RATES_ENABLED=false
# Сколько раз за один вопрос модель может запросить вызовы инструментов (к любому
# числу источников сразу), прежде чем ей предложат ответить без них (целое число не
# меньше 1). По умолчанию 8: цепочка «поиск → история → сравнение» при вызовах по
# одному занимает пять шагов.
MCP_MAX_TOOL_STEPS=8
# Предельный размер (в символах) результата ОДНОГО вызова инструмента, который
# передаётся модели — общий на все источники. 50000 вмещает полный ответ
# get_price_history с запасом у MOEX/Bybit (300 свечей: ≈42 300 символов у MOEX,
# ≈45 000 у Bybit, в компактном виде); ответы Банка России заметно короче. При
# превышении результат обрезается с пометкой. Больше значение — больше токенов на вопрос.
MCP_TOOL_RESULT_MAX_CHARS=50000

# --- Опрос цен по тикерам с регулярными сводками (/watch, price_watch/) ---
# Пользователь командой /watch задаёт тикеры и периоды (опроса и сводки), а бот сам
# присылает сводки в чат по расписанию, без вопроса от пользователя. Опрос и хранение
# замеров выполняет тот же локальный сервер mcp-moex (в режиме `--watch-db`), поэтому
# возможность активна, только если задан MCP_MOEX_DIR выше (нужна версия сервера с
# инструментами watch_*). Это настройка оператора: пользователь чата не может ни выбрать
# сервер, ни поменять путь к хранилищу.
# PRICE_WATCH включает/выключает команды /watch, /watch_status, /watch_report,
# /watch_stop — отдельно от MCP_MOEX_DIR, чтобы можно было оставить smart-агенту данные
# биржи, но не включать бота, который пишет сам. Допустимые значения: true/false (также
# принимаются 1/0, yes/no, on/off). По умолчанию — true.
PRICE_WATCH=true
# Файл SQLite с опросами, замерами и сводками (идентификатор чата, тикеры, публичные
# цены). Создаётся сервером при первом использовании. Относительный путь считается от
# рабочего каталога бота и превращается в абсолютный при запуске (сервер стартует в
# каталоге mcp-moex). Каталог data/ в .gitignore.
PRICE_WATCH_DB=data/price_watch/watch.sqlite3
# Предельное время (в секундах) одного обращения к серверу: запуск процесса, рукопожатие
# и вызов инструмента. Плановый вызов опрашивает биржу по всем чатам разом, поэтому
# значение больше MCP_TIMEOUT_SECONDS. Число больше 0.
PRICE_WATCH_TIMEOUT_SECONDS=90

# --- Индексация документов и эмбеддинги (rag/, providers/embeddings_client.py) ---
# Офлайн-пайплайн `python -m rag.cli` (он же `make index`) разбивает корпус документов
# data/source/pdf/ и data/source/txt/ на чанки двумя независимыми стратегиями и строит
# по отдельному индексу FAISS+SQLite на каждую. Не привязан к RESEARCH — пайплайн
# запускается только вручную; RESEARCH ниже управляет только двумя командами бота,
# читающими уже построенный индекс (/research_chunking_stats, /research_chunking_compare).

# Эндпоинт эмбеддингов — локальный сервер Ollama (OpenAI-совместимый /v1/embeddings), а
# не DeepSeek/Kimi: у DeepSeek такого эндпоинта нет, а Kimi требовал бы KIMI_API_KEY
# независимо от MAIN_CLIENT и сетевого вызова на каждый чанк корпуса. Нужна локально
# запущенная Ollama с загруженной моделью (`ollama pull bge-m3`). Недоступность Ollama
# не мешает запуску бота — она нужна только CLI и двум командам RESEARCH ниже.
EMBEDDINGS_BASE_URL=http://localhost:11434/v1
EMBEDDINGS_MODEL=bge-m3

# Каталог с индексами FAISS+SQLite — по одной паре файлов на стратегию чанкинга
# (RAG_INDEX_DIR/fixed/, RAG_INDEX_DIR/structural/), полностью пересобираемых каждым
# запуском CLI. Каталог data/ в .gitignore.
RAG_INDEX_DIR=data/rag_index

# Стратегия фиксированного размера: длина окна и перекрытие в символах (не в токенах —
# чанкинг не зависит от конкретной модели эмбеддингов). Перекрытие должно быть меньше
# длины окна.
RAG_FIXED_CHUNK_CHARS=1200
RAG_FIXED_CHUNK_OVERLAP=200

# Сколько чанков от каждой стратегии показывает /research_chunking_compare на один
# запрос пользователя. Целое число не меньше 1.
RAG_COMPARE_TOP_K=3
