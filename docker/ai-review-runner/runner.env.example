# Образец настроек runner: скопируйте в runner.env (в git не попадает). Значения задаёт оператор.
REPO=owner/repo
# Модель ревью и сервер Ollama на хосте (порт 11434 должен быть опубликован).
PR_REVIEW_MODEL=gpt-oss:20b
PR_REVIEW_PROVIDER=ollama
PR_REVIEW_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDINGS_MODEL=bge-m3
PR_REVIEW_INDEX_DIR=/index
# Ответ на CPU занимает минуты; контекст Ollama на сервере — OLLAMA_CONTEXT_LENGTH >= 16384.
PR_REVIEW_TIMEOUT_SECONDS=900
PR_REVIEW_MAX_CHARS=24000
PR_REVIEW_TOP_K=8
