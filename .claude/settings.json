{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/ruff check:*)",
      "Bash(.venv/bin/python -m compileall:*)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(TELEGRAM_BOT_TOKEN=x DEEPSEEK_API_KEY=x .venv/bin/pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}
