+"""Тесты текстов глоссария (terms/texts.py): оговорка и отсутствие гарантий."""
+
+import re
+
+from terms import rules, texts
+
+GUARANTEE = re.compile(
+    r"гарантир\w+|точно\s+(?:вырастет|упадёт)|наверняка|обязательно\s+(?:вырастет|принесёт)|"
+    r"доходность\s+составит|покупайте|продавайте",
+    re.IGNORECASE,
+)
+
+
+def assert_has_disclaimer(text):
+    assert "не инвестиционная рекомендация и не прогноз" in text
+    assert "не является лицензированным финансовым советником" in text
+
+
+def test_list_and_definitions_have_disclaimer():
+    assert_has_disclaimer(texts.text_list(rules.list_terms()))
+    for term, definition in rules.GLOSSARY.items():
+        assert_has_disclaimer(texts.text_definition(term, definition))
+
+
+def test_list_contains_all_terms():
+    text = texts.text_list(rules.list_terms())
+    assert all(term in text for term in rules.GLOSSARY)
+
+
+def test_not_found_variants():
+    assert "дивиденд" in texts.text_not_found("дивидент", ["дивиденд"])
+    assert "/terms" in texts.text_not_found("xyz", [])
+
+
+def test_no_guarantees_in_texts():
+    for term, definition in rules.GLOSSARY.items():
+        assert GUARANTEE.search(texts.text_definition(term, definition)) is None, term
+    assert GUARANTEE.search(texts.DISCLAIMER) is None
