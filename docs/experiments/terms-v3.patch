@@ -0,0 +1,34 @@
+"""Тесты правил глоссария (terms/rules.py)."""
+
+from terms import rules
+
+
+def test_glossary_has_eight_terms_with_lowercase_keys():
+    assert len(rules.GLOSSARY) == 8
+    assert all(k == k.lower() and v for k, v in rules.GLOSSARY.items())
+
+
+def test_list_terms_sorted():
+    assert rules.list_terms() == sorted(rules.GLOSSARY)
+
+
+def test_find_definition_ignores_case_and_spaces():
+    assert rules.find_definition("  ДиВиДенд ") == rules.GLOSSARY["дивиденд"]
+
+
+def test_find_definition_unknown_is_none():
+    assert rules.find_definition("фьючерс") is None
+
+
+def test_suggest_by_prefix_and_typo():
+    assert "дивиденд" in rules.suggest("дивидент")
+    assert "акция" in rules.suggest("акци")
+
+
+def test_suggest_empty_and_unrelated():
+    assert rules.suggest("   ") == []
+    assert rules.suggest("xyz") == []
+
+
+def test_suggest_limit():
+    assert len(rules.suggest("и")) <= rules.SUGGEST_LIMIT
