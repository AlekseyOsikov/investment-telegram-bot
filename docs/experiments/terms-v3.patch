+"""Чистые правила глоссария `/terms`: словарь терминов и поиск по нему.
+
+Словарь хранится в коде; модуль не знает про Telegram, сеть, диск, модель и `config`.
+Определения — образовательные пояснения, не рекомендации и не прогнозы.
+Тесты — `tests/test_terms_rules.py`.
+"""
+
+from __future__ import annotations
+
+import difflib
+
+# --- Словарь: термин (нижний регистр) -> определение ---------------------------------------
+
+GLOSSARY: dict[str, str] = {
+    "акция": (
+        "Ценная бумага, подтверждающая долю владельца в капитале компании. Её цена меняется "
+        "вслед за рынком, а выплата дивидендов не обещана заранее."
+    ),
+    "облигация": (
+        "Долговая ценная бумага: эмитент берёт деньги в долг, обязуется вернуть номинал в "
+        "срок погашения и, как правило, выплачивать купоны. Эмитент может не исполнить "
+        "обязательства."
+    ),
+    "дивиденд": (
+        "Часть прибыли компании, которую она может направить на выплату акционерам. Решение о "
+        "выплате и её размере принимает компания, заранее они неизвестны."
+    ),
+    "купон": (
+        "Периодический процентный платёж по облигации. Размер и даты выплат задаются условиями "
+        "выпуска облигации."
+    ),
+    "ликвидность": (
+        "Насколько быстро актив можно продать по цене, близкой к рыночной. У малоторгуемых "
+        "бумаг продажа может занять больше времени или пройти с заметной уступкой в цене."
+    ),
+    "волатильность": (
+        "Мера того, насколько сильно и часто меняется цена актива. Высокая волатильность "
+        "означает более резкие колебания в обе стороны."
+    ),
+    "диверсификация": (
+        "Распределение средств между разными активами, отраслями или странами, чтобы "
+        "результат не зависел от одного источника риска. Она снижает риск, но не исключает "
+        "убытков."
+    ),
+    "индекс": (
+        "Расчётный показатель, отражающий изменение цен набора ценных бумаг, например "
+        "рынка или отрасли. Сам индекс не купить, но существуют фонды, которые его повторяют."
+    ),
+}
+
+SUGGEST_LIMIT = 3
+SUGGEST_CUTOFF = 0.6
+
+
+def normalize(query: str) -> str:
+    """Приводит ввод к ключу словаря: без лишних пробелов, в нижнем регистре."""
+    return " ".join(query.split()).lower()
+
+
+def list_terms() -> list[str]:
+    """Термины словаря по алфавиту."""
+    return sorted(GLOSSARY)
+
+
+def find_definition(query: str) -> str | None:
+    """Определение термина или None, если его нет."""
+    return GLOSSARY.get(normalize(query))
+
+
+def suggest(query: str) -> list[str]:
+    """Похожие термины: общее начало, вхождение подстроки и близкое написание."""
+    key = normalize(query)
+    if not key:
+        return []
+    found: list[str] = []
+    for term in list_terms():
+        if term.startswith(key[:4]) or key in term or term in key:
+            found.append(term)
+    close = difflib.get_close_matches(
+        key, list_terms(), n=SUGGEST_LIMIT, cutoff=SUGGEST_CUTOFF
+    )
+    for term in close:
+        if term not in found:
+            found.append(term)
+    return found[:SUGGEST_LIMIT]
