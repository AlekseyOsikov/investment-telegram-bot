+"""Команда `/terms` — глоссарий инвестиционных терминов (личные чаты).
+
+Тонкий хендлер: без сети, LLM, памяти и хранения данных; ввод пользователя не сохраняется.
+"""
+
+from __future__ import annotations
+
+from telegram import Update
+from telegram.ext import CommandHandler, ContextTypes, filters
+
+from . import rules, texts
+
+
+async def terms_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """/terms — список терминов; /terms <термин> — определение или похожие термины."""
+    query = " ".join(context.args or [])
+    if not rules.normalize(query):
+        await update.message.reply_text(texts.text_list(rules.list_terms()))
+        return
+    definition = rules.find_definition(query)
+    if definition is None:
+        await update.message.reply_text(texts.text_not_found(query, rules.suggest(query)))
+        return
+    await update.message.reply_text(texts.text_definition(rules.normalize(query), definition))
+
+
+def build_terms_handlers() -> list[CommandHandler]:
+    """Обработчики глоссария, только для личных чатов."""
+    return [CommandHandler("terms", terms_command, filters=filters.ChatType.PRIVATE)]
