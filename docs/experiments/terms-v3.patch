@@ -0,0 +1,35 @@
+"""Тексты `/terms` пользователю (обычный текст, без parse_mode).
+
+Оговорка — константа кода и входит в каждое определение; тесты — `tests/test_terms_texts.py`.
+"""
+
+from __future__ import annotations
+
+DISCLAIMER = (
+    "Справочное пояснение, не инвестиционная рекомендация и не прогноз. "
+    "Бот не является лицензированным финансовым советником."
+)
+
+
+def text_list(terms: list[str]) -> str:
+    """Список терминов и подсказка по использованию."""
+    lines = "\n".join(f"• {term}" for term in terms)
+    return (
+        f"Доступные термины:\n{lines}\n\n"
+        "Определение: /terms <термин>, например /terms дивиденд.\n"
+        f"{DISCLAIMER}"
+    )
+
+
+def text_definition(term: str, definition: str) -> str:
+    """Определение термина с оговоркой."""
+    return f"{term.capitalize()} — {definition}\n\n{DISCLAIMER}"
+
+
+def text_not_found(query: str, similar: list[str]) -> str:
+    """Термина нет: похожие варианты или отсылка к списку."""
+    shown = query.strip()[:50]
+    if similar:
+        options = ", ".join(similar)
+        return f"Термина «{shown}» нет в глоссарии. Возможно, вы искали: {options}."
+    return f"Термина «{shown}» нет в глоссарии. Список терминов: /terms."
