+"""Тексты `/terms`: список терминов, определение, «не найдено». Оговорка — в каждом ответе."""
+
+from __future__ import annotations
+
+DISCLAIMER_ADVISOR = "Бот не является лицензированным финансовым советником."
+DISCLAIMER_NOT_ADVICE = "Это справочное определение, а не инвестиционная рекомендация и не прогноз."
+DISCLAIMER = f"{DISCLAIMER_ADVISOR} {DISCLAIMER_NOT_ADVICE}"
+
+
+def terms_list_text(terms: list[str]) -> str:
+    """Список терминов и подсказка по использованию."""
+    lines = "\n".join(f"- {term}" for term in terms)
+    return (
+        f"Доступные термины:\n{lines}\n\n"
+        "Определение термина: /terms <термин>, например /terms дивиденд.\n\n"
+        f"{DISCLAIMER}"
+    )
+
+
+def definition_text(term: str, definition: str) -> str:
+    """Определение термина."""
+    return f"{term.capitalize()}: {definition}\n\n{DISCLAIMER}"
+
+
+def not_found_text(query: str, suggestions: list[str]) -> str:
+    """Термина нет в словаре; при наличии — похожие."""
+    shown = query if len(query) <= 60 else query[:57] + "..."
+    head = f"Термина «{shown}» нет в глоссарии."
+    if suggestions:
+        head += " Возможно, вы имели в виду: " + ", ".join(suggestions) + "."
+    else:
+        head += " Список терминов — /terms."
+    return f"{head}\n\n{DISCLAIMER}"
