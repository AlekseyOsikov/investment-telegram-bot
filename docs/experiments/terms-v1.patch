+++ b/src/terms/rules.py
@@ -0,0 +1,115 @@
+"""Чистые правила глоссария /terms: словарь терминов, поиск, тексты.
+
+Не импортирует `config`, не трогает сеть и диск. Определения — общеобразовательные,
+без оценок и рекомендаций.
+"""
+
+import difflib
+
+# Ключ — нормализованное название (нижний регистр), значение — определение.
+TERMS: dict[str, str] = {
+    "акция": (
+        "Ценная бумага, которая подтверждает долю владельца в капитале компании. "
+        "Держатель может получать часть прибыли в виде дивидендов; цена акции "
+        "меняется на бирже и может как расти, так и падать."
+    ),
+    "облигация": (
+        "Долговая ценная бумага: эмитент занимает деньги у инвестора и обязуется "
+        "вернуть номинал в установленный срок и, как правило, платить купонный доход. "
+        "Облигации тоже несут риски, например кредитный риск эмитента."
+    ),
+    "дивиденд": (
+        "Часть прибыли компании, которую она может выплатить акционерам. Решение о "
+        "выплате и её размере принимает компания; выплата не обязательна и не "
+        "гарантирована."
+    ),
+    "купон": (
+        "Периодический процентный платёж по облигации. Размер и даты выплат "
+        "определены условиями выпуска; при дефолте эмитента выплата может не состояться."
+    ),
+    "ликвидность": (
+        "Насколько быстро актив можно продать по цене, близкой к рыночной. "
+        "У ликвидных бумаг много покупателей и продавцов, у малоликвидных сделка "
+        "может занять время или потребовать уступки в цене."
+    ),
+    "волатильность": (
+        "Мера размаха колебаний цены актива за период. Высокая волатильность "
+        "означает резкие изменения цены в обе стороны; это характеристика "
+        "прошлых колебаний, а не прогноз."
+    ),
+    "диверсификация": (
+        "Распределение вложений между разными активами, отраслями или странами, "
+        "чтобы падение одного из них меньше влияло на весь портфель. Снижает "
+        "зависимость от отдельного актива, но не исключает убытков."
+    ),
+    "индекс": (
+        "Показатель, который отражает движение цен выбранной группы бумаг, "
+        "например индекс Московской биржи. Служит ориентиром состояния рынка "
+        "или его сегмента."
+    ),
+}
+
+DISCLAIMER = "Справочная информация, не индивидуальная инвестиционная рекомендация."
+
+
+def normalize(raw: str) -> str:
+    """Регистр и пробелы по краям (и повторные внутри) не важны; «ё» равна «е»."""
+    return " ".join(raw.lower().replace("ё", "е").split())
+
+
+_INDEX: dict[str, str] = {normalize(k): k for k in TERMS}
+
+
+def list_terms() -> list[str]:
+    return sorted(TERMS)
+
+
+def find_term(raw: str) -> str | None:
+    """Ключ словаря по пользовательскому вводу или None."""
+    return _INDEX.get(normalize(raw))
+
+
+def suggest(raw: str, limit: int = 3) -> list[str]:
+    """Похожие термины: по префиксу/вхождению, затем по близости написания."""
+    q = normalize(raw)
+    if not q:
+        return []
+    found: list[str] = []
+    for norm, key in _INDEX.items():
+        if norm.startswith(q) or q in norm or norm in q:
+            found.append(key)
+    for norm in difflib.get_close_matches(q, list(_INDEX), n=limit, cutoff=0.5):
+        if _INDEX[norm] not in found:
+            found.append(_INDEX[norm])
+    return found[:limit]
+
+
+def text_list() -> str:
+    items = "\n".join(f"• {t}" for t in list_terms())
+    return (
+        f"Доступные термины:\n{items}\n\n"
+        "Определение: /terms <термин>, например /terms дивиденд.\n" + DISCLAIMER
+    )
+
+
+def text_definition(key: str) -> str:
+    return f"{key.capitalize()} — {TERMS[key]}\n\n{DISCLAIMER}"
+
+
+def text_not_found(raw: str) -> str:
+    similar = suggest(raw)
+    if similar:
+        return (
+            "Такого термина нет в глоссарии. Возможно, вы имели в виду: "
+            + ", ".join(similar)
+            + ".\nВесь список — /terms."
+        )
+    return "Такого термина нет в глоссарии. Весь список — /terms."
+
+
+def answer(raw_args: str) -> str:
+    """Текст ответа на /terms с аргументами (пустая строка — список)."""
+    if not normalize(raw_args):
+        return text_list()
+    key = find_term(raw_args)
+    return text_definition(key) if key else text_not_found(raw_args)
