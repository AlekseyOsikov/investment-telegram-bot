@@ -0,0 +1,36 @@
+from terms import rules
+
+
+def test_eight_terms():
+    assert len(rules.TERMS) == 8
+    assert all(rules.TERMS.values())
+
+
+def test_list_without_args():
+    text = rules.answer("   ")
+    for term in rules.TERMS:
+        assert term in text
+
+
+def test_case_and_spaces_ignored():
+    assert rules.answer("  ДИВИДЕНД ") == rules.answer("дивиденд")
+    assert "Дивиденд —" in rules.answer("дивиденд")
+
+
+def test_yo_equals_ye():
+    assert rules.find_term("Индекс") == "индекс"
+
+
+def test_suggest_typo_and_prefix():
+    assert "волатильность" in rules.suggest("волатильнось")
+    assert "облигация" in rules.suggest("облиг")
+
+
+def test_not_found_with_and_without_similar():
+    assert "ликвидность" in rules.answer("ликвидносить")
+    text = rules.answer("zzzz")
+    assert "нет в глоссарии" in text and "Возможно" not in text
+
+
+def test_disclaimer_in_definition():
+    assert rules.DISCLAIMER in rules.answer("купон")
