@@ -0,0 +1,15 @@
+"""Командный слой /terms: глоссарий терминов (без сети и LLM, только личные чаты)."""
+
+from telegram import Update
+from telegram.ext import CommandHandler, ContextTypes, filters
+
+from terms.rules import answer
+
+
+async def terms_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """/terms [термин] — список терминов или определение одного."""
+    await update.message.reply_text(answer(" ".join(context.args or [])))
+
+
+def build_terms_handler() -> CommandHandler:
+    return CommandHandler("terms", terms_command, filters=filters.ChatType.PRIVATE)
