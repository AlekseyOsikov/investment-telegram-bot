@@ -0,0 +1,88 @@
+"""Чистые правила глоссария `/terms`: словарь терминов, нормализация, поиск, похожие термины.
+
+Словарь хранится в коде; сеть, LLM и диск не используются. Определения — общие, образовательные,
+без оценок, прогнозов и советов. Модуль не импортирует `config`.
+"""
+
+from __future__ import annotations
+
+import difflib
+
+MAX_SUGGESTIONS = 3
+SIMILARITY_CUTOFF = 0.6
+
+GLOSSARY: dict[str, str] = {
+    "акция": (
+        "Ценная бумага, которая подтверждает долю владельца в капитале компании. "
+        "Владелец акции может получать часть прибыли в виде дивидендов, а цена акции "
+        "на бирже меняется."
+    ),
+    "волатильность": (
+        "Показатель того, насколько сильно и часто меняется цена актива за период. "
+        "Чем выше волатильность, тем шире разброс цен; сама по себе она не указывает "
+        "направление движения."
+    ),
+    "дивиденд": (
+        "Часть прибыли компании, которую она может направить на выплату акционерам. "
+        "Решение о выплате и её размере принимает компания; выплата не обязательна, "
+        "и компания может её отменить."
+    ),
+    "диверсификация": (
+        "Распределение средств между разными активами, отраслями или странами, чтобы "
+        "итог меньше зависел от одного из них. Она снижает зависимость от отдельного "
+        "актива, но не исключает риск потерь."
+    ),
+    "индекс": (
+        "Расчётный показатель, который отражает изменение цен набора бумаг, например "
+        "акций крупных компаний рынка. Индекс используют как ориентир состояния рынка "
+        "или его части."
+    ),
+    "купон": (
+        "Периодический процентный платёж по облигации, который эмитент выплачивает "
+        "держателю на условиях выпуска. Размер и даты выплат указаны в параметрах "
+        "облигации."
+    ),
+    "ликвидность": (
+        "Насколько быстро актив можно купить или продать по цене, близкой к рыночной. "
+        "У высоколиквидных бумаг много сделок и небольшой разрыв между ценами покупки "
+        "и продажи."
+    ),
+    "облигация": (
+        "Долговая ценная бумага: эмитент занимает деньги у держателя и обязуется "
+        "вернуть номинал в срок погашения, обычно с выплатой купонов. Остаётся риск, "
+        "что эмитент не исполнит обязательства."
+    ),
+}
+
+
+def normalize(query: str) -> str:
+    """Приводит запрос к ключу словаря: без пробелов по краям, в нижнем регистре, ё как ё."""
+    return " ".join(query.casefold().split())
+
+
+def list_terms() -> list[str]:
+    """Термины словаря по алфавиту."""
+    return sorted(GLOSSARY)
+
+
+def find_definition(query: str) -> tuple[str, str] | None:
+    """(термин, определение) или None, если точного совпадения нет."""
+    key = normalize(query)
+    if key in GLOSSARY:
+        return key, GLOSSARY[key]
+    return None
+
+
+def suggest(query: str, limit: int = MAX_SUGGESTIONS) -> list[str]:
+    """Похожие термины: по общему началу/вхождению и по близости написания."""
+    key = normalize(query)
+    if not key:
+        return []
+    found: list[str] = []
+    for term in list_terms():
+        if term.startswith(key[:3]) and len(key) >= 3 or key in term or term in key:
+            found.append(term)
+    for term in difflib.get_close_matches(key, list_terms(), n=limit, cutoff=SIMILARITY_CUTOFF):
+        if term not in found:
+            found.append(term)
+    return found[:limit]
