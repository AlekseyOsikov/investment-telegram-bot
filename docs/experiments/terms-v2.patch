+"""Тесты текстов глоссария (terms/texts.py): оговорка в каждом ответе, без гарантий."""
+
+import re
+
+from terms import rules, texts
+
+GUARANTEE = re.compile(
+    r"гарантир\w+|точно\s+(?:вырастет|упадёт)|наверняка|доходность\s+составит|"
+    r"рекомендуем\s+купить|стоит\s+купить",
+    re.IGNORECASE,
+)
+
+
+def all_replies():
+    replies = [texts.terms_list_text(rules.list_terms())]
+    replies += [texts.definition_text(t, d) for t, d in rules.GLOSSARY.items()]
+    replies.append(texts.not_found_text("опцион", []))
+    replies.append(texts.not_found_text("диверс", ["диверсификация"]))
+    return replies
+
+
+def test_disclaimer_in_every_reply():
+    for reply in all_replies():
+        assert texts.DISCLAIMER_ADVISOR in reply
+        assert texts.DISCLAIMER_NOT_ADVICE in reply
+
+
+def test_no_guarantees():
+    for term, definition in rules.GLOSSARY.items():
+        assert GUARANTEE.search(definition) is None, term
+    for reply in all_replies():
+        assert GUARANTEE.search(texts.DISCLAIMER) is None
+        assert reply
+
+
+def test_list_contains_all_terms():
+    reply = texts.terms_list_text(rules.list_terms())
+    for term in rules.GLOSSARY:
+        assert term in reply
+
+
+def test_not_found_suggestions_and_truncation():
+    assert "диверсификация" in texts.not_found_text("диверс", ["диверсификация"])
+    assert len(texts.not_found_text("я" * 500, [])) < 400
