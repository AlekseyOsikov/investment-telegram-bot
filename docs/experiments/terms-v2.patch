@@ -0,0 +1,33 @@
+"""Тесты правил глоссария (terms/rules.py)."""
+
+from terms import rules
+
+
+def test_glossary_has_eight_terms():
+    assert len(rules.GLOSSARY) == 8
+    assert rules.list_terms() == sorted(rules.GLOSSARY)
+
+
+def test_find_ignores_case_and_spaces():
+    assert rules.find_definition("  ДИВИДЕНД ")[0] == "дивиденд"
+    assert rules.find_definition("Купон")[1] == rules.GLOSSARY["купон"]
+
+
+def test_find_unknown_and_empty():
+    assert rules.find_definition("опцион") is None
+    assert rules.find_definition("   ") is None
+
+
+def test_suggest_typo_and_prefix():
+    assert "волатильность" in rules.suggest("волатильнось")
+    assert "диверсификация" in rules.suggest("диверс")
+    assert "облигация" in rules.suggest("облигации")
+
+
+def test_suggest_nothing():
+    assert rules.suggest("") == []
+    assert rules.suggest("qqqq") == []
+
+
+def test_suggest_limit():
+    assert len(rules.suggest("и", limit=2)) <= 2
