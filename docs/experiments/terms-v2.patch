+"""Команда `/terms` — глоссарий инвестиционных терминов (личные чаты, без сети и LLM)."""
+
+from __future__ import annotations
+
+from telegram import Update
+from telegram.ext import CommandHandler, ContextTypes, filters
+
+from . import rules, texts
+
+
+async def terms_command(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
+    """`/terms` — список; `/terms <термин>` — определение или похожие термины."""
+    if update.message is None:
+        return
+    query = " ".join(context.args or [])
+    if not rules.normalize(query):
+        reply = texts.terms_list_text(rules.list_terms())
+    else:
+        found = rules.find_definition(query)
+        if found is not None:
+            reply = texts.definition_text(*found)
+        else:
+            reply = texts.not_found_text(query.strip(), rules.suggest(query))
+    await update.message.reply_text(reply)
+
+
+def build_terms_handlers() -> list[CommandHandler]:
+    """Команда глоссария, только для личных чатов."""
+    return [CommandHandler("terms", terms_command, filters=filters.ChatType.PRIVATE)]
