# Рабочий тег локальной модели для бота: qwen3:30b-a3b с контекстом 8192 (по умолчанию сервер даёт
# 4096, а промпт /smart_agent с материалами доходит до ~2600 токенов + ответ). Подобрано
# scripts/ollama_tune.py: скорость и качество в пределах шума относительно значений по умолчанию,
# цена — около +0,4 ГиБ памяти. SYSTEM здесь НЕ задаётся: системное сообщение бота его заменяет.
#
#   ollama create qwen3-30b-a3b-ctx8k -f scripts/ollama/qwen3-30b-a3b-ctx8k.Modelfile
#   затем в .env: MAIN_MODEL=qwen3-30b-a3b-ctx8k
FROM qwen3:30b-a3b
PARAMETER num_ctx 8192
