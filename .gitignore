# Секреты и локальная конфигурация
.env
.env.*
!.env.example

# Байт-код и кэш Python
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Виртуальные окружения
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/

# Логи
*.log

# Сборка / упаковка пакета
dist/
build/
*.egg-info/
*.egg

# Тесты / покрытие
.pytest_cache/
.coverage
htmlcov/

# Данные агентов (/agent, /smart_agent) — персональные данные пользователей, не в git
/data/

# Прочее
.DS_Store
*.swp

# Настройки runner AI-ревью (задаёт оператор; содержат ключ) и мусор FUSE
docker/ai-review-runner/runner.env
.fuse_hidden*

# Изолированные копии репозитория (git worktree) субагентов Claude Code
.claude/worktrees/

# Отчёты прогонов (make smoke, /qa-run)
reports/
qa-out/

# Fine-tuning: тяжёлые артефакты и внешние инструменты не в git
/finetuning/artifacts/*
!/finetuning/artifacts/README.md
/finetuning/**/merged/
/finetuning/**/*.gguf
/finetuning/**/adapter_model.safetensors
/finetuning/**/model.safetensors
/finetuning/**/.venv/
/finetuning/**/llama.cpp/
/finetuning/**/watch_results*/
